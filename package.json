{
  "name": "pi-wayfarer",
  "version": "0.5.1",
  "description": "Session navigator for the pi coding agent: content-derived titles, a toggleable left overlay to browse/switch sessions, per-session summaries, and staleness badges.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "sessions",
    "tui"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "eval": "node test/evaluate-sessions.ts"
  },
  "author": "Alexander Schindler",
  "repository": {
    "type": "git",
    "url": "https://github.com/A7exSchin/pi-wayfarer.git"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  }
}
